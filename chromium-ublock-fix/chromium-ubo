#!/usr/bin/env python3
"""Launch this bundle's Chromium copy; rebuild and verify it after upgrades."""
from pathlib import Path
import argparse
import fcntl
import os
import shlex
import subprocess
import sys

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import repair


def main():
    parser = argparse.ArgumentParser(
        description='启动当前项目的 Chromium + uBlock Origin；其余参数传给浏览器。')
    parser.add_argument('--base-dir', type=Path, default=repair.DEFAULT_BASE,
                        help='运行数据目录，需与修复命令一致，默认：项目目录/.state')
    parser.add_argument('--source', type=Path, help='系统 Chromium ELF 主程序路径')
    parser.add_argument('--extension', type=Path, help='自定义 uBlock Origin 解包目录')
    config_home = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    parser.add_argument('--user-data-dir', type=Path, default=config_home / 'chromium',
                        help='浏览器数据目录，默认复用当前用户的 Chromium 配置')
    parser.add_argument('--verify-installation', action='store_true',
                        help='只检查兼容副本，不启动浏览器或修改文件')
    args, browser_args = parser.parse_known_args()
    if sys.version_info < (3, 11):
        raise repair.RepairError('需要 Python 3.11 或更高版本。')
    if os.geteuid() == 0:
        raise repair.RepairError('请以普通用户运行，不要使用 sudo。')
    base = args.base_dir.expanduser().absolute()
    source = repair.configured_source(base, args.source)
    repair.validate_source(source)
    extension = repair.configured_extension(base, args.extension)
    command = [sys.executable, str(HERE / 'repair.py'), '--base-dir', str(base),
               '--source', str(source), '--extension', str(extension)]
    if args.verify_installation:
        return subprocess.run([*command, '--check']).returncode
    if not repair.current_installation(base, source, repair.digest(source), extension):
        print('正在构建或更新兼容副本，并验证 uBlock Origin……', flush=True)
        result = subprocess.run([*command, '--auto'], capture_output=True, text=True)
        if base.is_dir():
            (base / 'last-auto-repair.log').write_text(result.stdout + result.stderr)
        print(result.stdout, end='', flush=True)
        if result.returncode:
            raise repair.RepairError(result.stderr or '自动修复失败，请查看运行数据目录中的日志。')
    # Do not replace the runtime while startup verifies and opens it.
    with (base / 'repair.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            raise repair.RepairError('兼容副本正在修复，请完成后再次启动。')
        if not repair.current_installation(base, source, repair.digest(source), extension):
            raise repair.RepairError('启动前系统 Chromium 或兼容副本再次发生变化，请重试。')
        for pid in repair.browser_processes(base, source):
            try:
                executable = os.readlink(Path('/proc', str(pid), 'exe')).removesuffix(' (deleted)')
            except OSError:
                continue
            if executable == str(source):
                raise repair.RepairError('请先完全退出普通 Chromium，再从本项目入口启动。')
        flags = []
        for path in (Path('/etc/chromium-flags.conf'), config_home / 'chromium-flags.conf'):
            if path.is_file():
                for line in path.read_text().splitlines():
                    flags.extend(shlex.split(line, comments=True))
        binary = base / 'runtime/chromium'
        os.execv(str(binary), [str(binary), *flags,
                 '--user-data-dir=' + str(args.user_data_dir.expanduser().absolute()),
                 '--load-extension=' + str(extension), *browser_args])
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (repair.RepairError, OSError, ValueError, subprocess.SubprocessError) as error:
        print('启动失败：' + str(error), file=sys.stderr)
        raise SystemExit(1)
